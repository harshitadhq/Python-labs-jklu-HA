#6
menu_items = input().split()

prices = list(map(int, input().split()))

ordered = input().split()

quantity = {}
for item in ordered:
    if item in quantity:
        quantity[item] += 1
    else:
        quantity[item] = 1

total = 0
for i in range(len(menu_items)):
    item = menu_items[i]
    if item in quantity:
        qty = quantity[item]
        cost = qty * prices[i]
        print(item, "x", qty, "=", cost)
        total += cost

print("Total:", total)


