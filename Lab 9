#3
balls = input().split()

total_runs = 0
wickets = 0
boundaries = 0
runs_per_over = []
current_over_runs = 0
ball_count = 0

for ball in balls:
    if ball == 'W':
        # Wicket means 0 runs
        wickets += 1
    else:
        runs = int(ball)
        total_runs += runs
        current_over_runs += runs
        if runs == 4 or runs == 6:
            boundaries += 1

    ball_count += 1

    # After every 6 balls, save the over and start a new one
    if ball_count % 6 == 0:
        runs_per_over.append(current_over_runs)
        current_over_runs = 0

if ball_count % 6 != 0:
    runs_per_over.append(current_over_runs)

print("Total Runs:", total_runs)
print("Wickets:", wickets)
print("Boundaries:", boundaries)
print("Runs per over:", runs_per_over)


