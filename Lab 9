n = int(input())

name_count = {}

for i in range(n):
    name = input()
    name_lower = name.lower()

    if name_lower in name_count:
        name_count[name_lower] += 1
    else:
        name_count[name_lower] = 1

    parts = name_lower.split()
    first = parts[0]
    last = parts[1]

    count = name_count[name_lower]

    if count == 1:
        email = first + "." + last + "@jklu.edu.in"
    else:
        email = first + "." + last + str(count) + "@jklu.edu.in"

    print(email)


